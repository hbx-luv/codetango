rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Default deny — overridden by more specific matches below.
    match /{document=**} {
      allow read, write: if false;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Live status doc for admin-triggered merge/recalc jobs. Written only
    // by the onCreateAdmin Cloud Function via the admin SDK; the admin page
    // subscribes for live progress.
    match /adminJobs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Writes only happen server-side via the admin SDK (onDeleteGame).
    // Reads stay open to support the deleted-games recovery UI in
    // game-detail / game-history.
    match /deletedGames/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /eloHistory/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /userToUserHistory/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /games/{document=**} {
      // TODO: get to the bottom of doc mmmNCiIPKhnU0qiYxeYO beign written to over and over
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /rooms/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-tab lurker heartbeats driving the spectator list. Anonymous viewers
    // must be able to write their own session doc, so this is deliberately
    // open to unauthenticated writes -- but only these two fields, and a
    // signed-in writer may only stamp their own uid. Deletes are open so any
    // client can garbage-collect stale sessions.
    match /rooms/{roomId}/presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
                                   ['userId', 'lastSeen'])
                    && request.resource.data.lastSeen is number
                    && (request.resource.data.userId == null
                        || (request.auth != null
                            && request.resource.data.userId == request.auth.uid));
      allow delete: if true;
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if true;

      // On create, the new doc may only contain whitelisted fields.
      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(
                        ['name', 'email', 'rooms', 'nickname', 'photoURL',
                         'lastActive']);

      // Any signed-in user may mint a synthetic bot player so "Add bot" can
      // seat it instantly, without a Cloud Function round trip. The `bot_`
      // namespace can't collide with a real player: auth uids never contain
      // underscores. isBot must be true so a bot doc can't impersonate a
      // human, and the whitelist keeps role/stats server-owned.
      allow create: if request.auth != null
                    && userId.matches('bot_.+')
                    && request.resource.data.isBot == true
                    && request.resource.data.keys().hasOnly(
                        ['name', 'email', 'rooms', 'isBot']);

      // On update, only whitelisted fields may change. This is what blocks
      // a user from self-promoting to role: 'Admin'. Server-side writes
      // (e.g. addRoomToUsers, stats recalc) go through the admin SDK and
      // bypass this rule.
      allow update: if isOwner()
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['name', 'email', 'rooms', 'nickname',
                                  'photoURL', 'lastActive']);
    }

    // Word lists are public game content; only admins can edit.
    // Cloud Functions read these via the admin SDK and bypass the rule.
    match /wordlists/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
