rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Default deny — overridden by more specific matches below.
    match /{document=**} {
      allow read, write: if false;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Live status doc for admin-triggered merge/recalc jobs. Written only
    // by the onCreateAdmin Cloud Function via the admin SDK; the admin page
    // subscribes for live progress.
    match /adminJobs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Writes only happen server-side via the admin SDK (onDeleteGame).
    // Reads stay open to support the deleted-games recovery UI in
    // game-detail / game-history.
    match /deletedGames/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Publicly readable pointer saying which stats set is live. Written only
    // by the recalc job via the admin SDK.
    match /system/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Elo / user-to-user history live in one of two blue/green collection
    // sets (see STATS_COLLECTIONS in types.ts). Both are readable; clients
    // pick the live one from /system/stats.
    match /eloHistory/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /eloHistoryGreen/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /userToUserHistory/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /userToUserHistoryGreen/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /games/{document=**} {
      // TODO: get to the bottom of doc mmmNCiIPKhnU0qiYxeYO beign written to over and over
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /rooms/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-tab lurker heartbeats driving the spectator list. Anonymous viewers
    // must be able to write their own session doc, so this is deliberately
    // open to unauthenticated writes -- but only these two fields, and a
    // signed-in writer may only stamp their own uid. Deletes are open so any
    // client can garbage-collect stale sessions.
    match /rooms/{roomId}/presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
                                   ['userId', 'lastSeen'])
                    && request.resource.data.lastSeen is number
                    && (request.resource.data.userId == null
                        || (request.auth != null
                            && request.resource.data.userId == request.auth.uid));
      allow delete: if true;
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if true;

      // On create, the new doc may only contain whitelisted fields.
      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(
                        ['name', 'email', 'rooms', 'nickname', 'photoURL',
                         'lastActive']);

      // Any signed-in user may mint a synthetic bot player so "Add bot" can
      // seat it instantly, without a Cloud Function round trip. The `bot_`
      // namespace can't collide with a real player: auth uids never contain
      // underscores. isBot must be true so a bot doc can't impersonate a
      // human, and the whitelist keeps role/stats server-owned.
      allow create: if request.auth != null
                    && userId.matches('bot_.+')
                    && request.resource.data.isBot == true
                    && request.resource.data.keys().hasOnly(
                        ['name', 'email', 'rooms', 'isBot']);

      // On update, only whitelisted fields may change. This is what blocks
      // a user from self-promoting to role: 'Admin'. Server-side writes
      // (e.g. addRoomToUsers, stats recalc) go through the admin SDK and
      // bypass this rule.
      allow update: if isOwner()
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['name', 'email', 'rooms', 'nickname',
                                  'photoURL', 'lastActive']);
    }

    // Word lists are public game content. Built-in lists (readable doc ids,
    // no owner) are admin-only. Signed-in players can add their own under an
    // auto id and then edit or delete only those. Cloud Functions read these
    // via the admin SDK and re-validate every entry before dealing a board.
    match /wordlists/{listId} {
      function validPlayerList(list) {
        return list.keys().hasOnly(
                   ['name', 'words', 'gameType', 'description', 'prompt',
                    'createdBy', 'createdAt', 'updatedAt'])
            && list.createdBy == request.auth.uid
            && list.name is string
            && list.name.size() > 0 && list.name.size() <= 60
            && list.words is list
            && list.words.size() <= 500
            && ((list.gameType == 'WORDS' && list.words.size() >= 25)
                || (list.gameType == 'IMAGES' && list.words.size() >= 20))
            && list.createdAt is number
            && list.updatedAt is number;
      }

      allow read: if true;
      allow write: if isAdmin();

      // The 20-character auto-id shape keeps players out of the built-in ids.
      allow create: if request.auth != null
                    && listId.matches('^[A-Za-z0-9]{20}$')
                    && validPlayerList(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && validPlayerList(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // Images uploaded for player-made lists, one per doc (the project has no
    // Storage bucket; Firestore's 1 MiB doc limit caps the size). Immutable
    // once written so boards from finished games keep rendering even after
    // the list that used them is edited or deleted.
    match /wordlistImages/{imageId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                        ['data', 'contentType', 'createdBy', 'createdAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.data is bytes
                    && request.resource.data.contentType in
                        ['image/png', 'image/jpeg', 'image/gif', 'image/webp']
                    && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
